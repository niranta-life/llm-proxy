# Local configuration for llm-proxy on Colima.
# ./llm-proxy-docker.sh setup copies this file to config/docker.env when that file is missing.
# It then stores a provider credential key when openssl is installed.
# Edit config/docker.env. Git does not track that file.
# Inference stays off until you set INFERENCE_ENABLED=true.
# Compose sets the database host to postgres.
# Do not add database settings, role names, role passwords, or the listen address to config/docker.env.
# The app command stays node dist/index.js.
# This file does not start the evaluation worker, the guardrail worker, or the promotion worker.

LOG_LEVEL=info
INFERENCE_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_CREDENTIAL_KEY=
PROVIDER_CREDENTIAL_KEY_PREVIOUS=
MAX_ACTIVE_STREAMS=32
MAX_STREAMS_PER_TENANT=32
STREAM_SHUTDOWN_DRAIN_MS=5000
HTTP_KEEP_ALIVE_TIMEOUT_MS=620000
MIGRATION_LOCK_TIMEOUT_MS=60000
MIGRATION_STATEMENT_TIMEOUT_MS=600000
