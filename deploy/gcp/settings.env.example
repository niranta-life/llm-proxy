# Your settings for scripts/gcp/*.
# scripts/gcp/up.sh writes deploy/gcp/settings.env from the answers you give at its
# prompts, so you rarely need to edit anything by hand. To start from this file instead:
#   cp deploy/gcp/settings.env.example deploy/gcp/settings.env
# settings.env is gitignored. It holds no secrets (and must never: values may only use
# letters, digits and . _ : / , @ + = - and spaces, because bash sources the file).
#
# A value set in the environment wins over this file:
#   PROJECT_ID=other-project scripts/gcp/up.sh --dry-run
#
# Required
PROJECT_ID="my-llm-proxy"  # existing GCP project, or a new id up.sh creates (needs BILLING_ACCOUNT)
DOMAIN="llm.example.com"   # public host name of the API

# Optional (defaults live in deploy/gcp/env.sh)
# BILLING_ACCOUNT="000000-AAAAAA-BBBBBB"        # only needed when up.sh must create the project
# REGION="us-central1"                          # GCP region for the cluster and registry
# TEAM_CIDRS="203.0.113.7/32 198.51.100.0/24"   # who may reach the API and cluster (max 50); default: this machine's IP
# DNS_ZONE="example-com"                        # Cloud DNS zone for DOMAIN; empty = you create the DNS records
# MIN_REPLICAS=1                                # app replicas at rest (at least 1)
# MAX_REPLICAS=4                                # app replicas at most (at least MIN_REPLICAS)
# PDB_MIN_AVAILABLE=0                           # pods that must stay up during node upgrades; below MIN_REPLICAS
# AUTOSCALER="hpa"                              # hpa or keda
# PG_INSTANCES=2                                # Postgres instances (at least 1)
# TENANT_NAME="default"                         # name of the first tenant providers.sh creates
# OPENAI_MODEL="gpt-4o-mini"                    # upstream model for deployment openai-mini
# ANTHROPIC_MODEL="claude-sonnet-4-5"           # upstream model for deployment claude
# VERTEX_MODEL="gemini-2.5-flash"               # upstream model for deployment vertex-flash

# Environment variables read by the scripts (not settings; set them per run):
#   DNS_WAIT_MINUTES=45      dns.sh: how long to wait for DNS and the certificate
#   SKIP_PUBLIC_CHECK=1      deploy.sh: skip the public URL check
#   LLM_KUBECONFIG=path      kubeconfig the scripts use (default ~/.config/llm-proxy/kubeconfig)
#   YES=1                    skip yes/no prompts (typed confirmations for destructive steps stay)
#   OPENAI_API_KEY_FILE, ANTHROPIC_API_KEY_FILE, ROTATE_API_KEY_FILE
#                            read a provider key from a file (mode 600) instead of the hidden prompt
