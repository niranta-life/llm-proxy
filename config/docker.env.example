# Local configuration for llm-proxy on Colima.
# ./llm-proxy-docker.sh setup copies this file to config/docker.env when that file is missing.
# It then stores a provider credential key when openssl is installed.
# Edit config/docker.env. Git does not track that file.
# Inference stays off until ./llm-proxy-docker.sh keys turns it on.
# That happens only when a provider key is set.
# Do not put a provider API key in this file.
# Put provider API keys in config/provider-keys.env.
# Compose sets the database host to postgres.
# Do not add database settings, role names, role passwords, or the listen address to config/docker.env.
# The app command stays node dist/index.js.
# This file does not start the evaluation worker, the guardrail worker, or the promotion worker.

LOG_LEVEL=info
INFERENCE_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
PROVIDER_CREDENTIAL_KEY=
PROVIDER_CREDENTIAL_KEY_PREVIOUS=
MAX_ACTIVE_STREAMS=32
MAX_STREAMS_PER_TENANT=32
STREAM_SHUTDOWN_DRAIN_MS=5000
HTTP_KEEP_ALIVE_TIMEOUT_MS=620000
MIGRATION_LOCK_TIMEOUT_MS=60000
MIGRATION_STATEMENT_TIMEOUT_MS=600000
# Rate limits stay in PostgreSQL unless you set redis_active.
# The default mode is postgres. Redis is optional.
# Start Redis with the Compose profile redis.
# Set RATE_LIMIT_STORE=redis_shadow to open a shadow connection.
# Set REDIS_SHADOW_CHECKS=true to compare a Redis token bucket.
# That check does not admit the request. The default is false.
# Set RATE_LIMIT_STORE=redis_active only after you approve one hard rate policy.
# An activation does nothing until that mode is set.
# Rollback is RATE_LIMIT_STORE=postgres.
# RATE_LIMIT_STORE=postgres
# REDIS_SHADOW_CHECKS=false
# REDIS_URL=redis://redis:6379
# REDIS_USERNAME=proxy
# REDIS_PASSWORD=local_redis_shadow_pw
# REDIS_TLS=false
# REDIS_CONNECT_TIMEOUT_MS=1000
# REDIS_RECONNECT_TIMEOUT_MS=1000
# REDIS_BREAKER_COOLDOWN_MS=1000
