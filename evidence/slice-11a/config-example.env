# Optional Redis shadow. The default mode is postgres.
# A shadow connection does not change admission.
# Start Redis with: docker compose --profile redis up -d redis

RATE_LIMIT_STORE=postgres

# RATE_LIMIT_STORE=redis_shadow
# REDIS_URL=redis://redis:6379
# REDIS_USERNAME=proxy
# REDIS_PASSWORD=local_redis_shadow_pw
# REDIS_TLS=false
# REDIS_CONNECT_TIMEOUT_MS=1000
# REDIS_RECONNECT_TIMEOUT_MS=1000
