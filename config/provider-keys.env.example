# Local provider keys for llm-proxy on Colima.
# ./llm-proxy-docker.sh setup copies this file to config/provider-keys.env when that file is missing.
# Edit config/provider-keys.env. Git does not track that file.
# Keep the file mode at 600 or 400. The script refuses a symlink.
# The script refuses group or other permission bits.
# Leave a key empty to skip that provider.
# ./llm-proxy-docker.sh keys reads this file. It does not print a key.
# The script does not source this file.
# Inference turns on only when a key below is set and you run keys.
# Selection stays off. Automatic promotion stays off.
# The script does not start the evaluation worker, the guardrail worker, or the promotion worker.
# The script does not mark a deployment validated.
# A named deployment is enabled only for a provider whose key is set.
# OpenAI, Anthropic, xAI, OpenRouter, Vertex, and DGX keys are replaced when you run keys again.
# keys updates upstream_model when the file model differs from the stored model.
# An empty ANTHROPIC_MAX_OUTPUT_TOKENS skips Anthropic. Other providers still apply.
# For claude-sonnet-5-5, capabilities omit temperature.
# Put the Vertex service account JSON on one line. Do not wrap that JSON in quotes.
# Do not put these keys in config/docker.env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_OUTPUT_TOKENS=1024
ANTHROPIC_WORKSPACE_ID=
XAI_API_KEY=
XAI_MODEL=grok-example
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
VERTEX_SERVICE_ACCOUNT_JSON=
VERTEX_PROJECT=
VERTEX_LOCATION=
VERTEX_MODEL=gemini-2.5-flash
DGX_API_KEY=
DGX_ENDPOINT=
DGX_MODEL=private-model
# A DGX call needs addresses in DGX_ALLOWLIST_ADDRESSES.
# Without those addresses, keys still stores the DGX key and does not call that host.
DGX_ALLOWLIST_ADDRESSES=
DGX_HEALTH_ENDPOINT=
DEPLOYMENT_TIMEOUT_MS=60000
DEPLOYMENT_CAPABILITIES=temperature,max_tokens
